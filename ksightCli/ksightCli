#!/usr/bin/env python3
import click
import os
import subprocess
import sys

# Add the script's directory to sys.path to ensure we can import commands_data
script_dir = os.path.dirname(os.path.abspath(__file__))
if script_dir not in sys.path:
    sys.path.insert(0, script_dir)

# Try to import generated commands data
try:
    from commands_data import COMMANDS
except ImportError:
    COMMANDS = {}

@click.group(name="ksightCli", context_settings=dict(
    help_option_names=['-h', '--help'],
))
def cli():
    """Ksight CLI - A unified interface for kernel observability tools."""
    pass

def create_command(name, info):
    @click.command(name=name, context_settings=dict(
        ignore_unknown_options=True,
        allow_extra_args=True,
    ))
    @click.pass_context
    def cmd(ctx, **kwargs):
        """Execute the backend tool."""
        # Determine install_dir
        # 1. Check if we are running from the installed location: /usr/local/bin/ksight/ksightCli/ksightCli
        #    In this case, the install_dir is the parent of our directory.
        script_dir = os.path.dirname(os.path.abspath(__file__))
        if os.path.basename(script_dir) == "ksightCli":
            install_dir = os.path.dirname(script_dir)
        else:
            # 2. Fallback to default or local build
            install_dir = "/usr/local/bin/ksight"
            if not os.path.exists(install_dir):
                base_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
                install_dir = os.path.join(base_dir, "build", "install")
            
        bin_path = os.path.join(install_dir, info["bin_path"])
        
        if not os.path.exists(bin_path):
            click.echo(f"Error: Backend tool not found at {bin_path}", err=True)
            sys.exit(1)
            
        # Get all arguments passed after the command name from sys.argv
        # to ensure we pass everything (including flags click might have parsed)
        try:
            # Find the command name in sys.argv to get everything after it
            # We use the last occurrence in case the tool name matches something earlier
            cmd_name = ctx.command.name
            # Find all indices of cmd_name
            indices = [i for i, x in enumerate(sys.argv) if x == cmd_name]
            if indices:
                raw_args = sys.argv[indices[-1] + 1:]
            else:
                raw_args = ctx.args
        except Exception:
            raw_args = ctx.args
            
        # Combine binary path with passed arguments
        args = [bin_path] + raw_args
        
        try:
            # Execute the tool and pipe output
            subprocess.run(args)
        except KeyboardInterrupt:
            pass
        except Exception as e:
            click.echo(f"Error executing tool: {e}", err=True)
            sys.exit(1)

    # Add options dynamically for help and tab completion
    for opt in info.get("options", []):
        flags = opt["flags"]
        help_text = opt["help"]
        opt_type = opt["type"]
        
        # Map JSON types to click types
        click_type = click.UNPROCESSED
        if opt_type == "int":
            click_type = int
        elif opt_type == "string":
            click_type = str
        elif opt_type == "bool":
            click_type = bool

        # For boolean flags, we use is_flag=True
        if opt_type == "bool":
            cmd = click.option(*flags, help=help_text, is_flag=True)(cmd)
        else:
            cmd = click.option(*flags, help=help_text, type=click_type)(cmd)
            
    return cmd

# Register all commands from metadata
for name, info in COMMANDS.items():
    cli.add_command(create_command(name, info))

if __name__ == "__main__":
    cli(prog_name="ksightCli")